# Server Configuration
PORT=8000
ENVIRONMENT=development

# 1. SQL Database (async SQLAlchemy; use your own URL here)
SUPABASE_DATABASE_URL=postgresql+asyncpg://campus:campus_password@localhost:5432/campus_hustle

# 2. NoSQL Database (unused by the backend today; ignored by Settings)
# MONGO_URL=mongodb+srv://user:password@cluster0.example.mongodb.net/?appName=Cluster0

# 3. Redis (rate limiting). Local:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
# REDIS_PASSWORD=
# Remote/Upstash hosts automatically use rediss:// (TLS).

# 4. JWT settings
SECRET_KEY=replace_with_a_long_random_secret_at_least_32_bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list (read as ALLOWED_ORIGINS or CORS_ORIGINS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Ignored by the backend (reserved for future features)
COOKIE_SECURE=false
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
